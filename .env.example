# ---- required for script generation ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- voice (pick one) ----
# ElevenLabs gives word-level timestamps -> best captions. Strongly recommended.
ELEVENLABS_API_KEY=
# Fallback TTS if ElevenLabs is unset (captions timed by estimation).
OPENAI_API_KEY=

# ---- optional b-roll ----
# Free API key from https://www.pexels.com/api/ . Without it the pipeline uses
# procedurally generated backgrounds, which need no assets and never 404.
PEXELS_API_KEY=

# ---- publishing ----
# YouTube: run `python run.py auth youtube` once to create youtube_token.json
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN=secrets/youtube_token.json

# TikTok Content Posting API (requires an approved developer app)
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API (Business/Creator account + Facebook app)
IG_USER_ID=
IG_ACCESS_TOKEN=
# Reels upload needs a publicly reachable video URL. Set the base URL of wherever
# you host rendered files (S3/R2/nginx). Leave blank to disable Instagram.
PUBLIC_MEDIA_BASE_URL=
